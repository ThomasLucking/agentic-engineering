#!/usr/bin/env bash
#
# Stub `herdr` for herdr-delegate.sh tests.
#
# Records every invocation to $HERDR_STUB_STATE/calls.log and returns
# JSON-RPC shaped responses matching herdr 0.7.0 (protocol 14) — ids under
# `.result.*`.
#
# Fault injection (env):
#   HERDR_STUB_FAIL="<cmd> <sub>"  fail that command (e.g. "tab create")
#   HERDR_STUB_DEAD_PANE=1         `pane get w1:p3` exits 1 (agent died at start)
#   HERDR_STUB_TOPLEVEL_IDS=1      `worktree create` emits ids at the top level
#                                  instead of under .result (the 0.7.0 regression
#                                  the script's header warns about)
#   HERDR_STUB_REMOVE_REAL=1       `worktree remove` really removes the worktree
#                                  (default: succeeds without removing, so the
#                                  script's git fallbacks are what get tested)

set -u

STATE="${HERDR_STUB_STATE:?HERDR_STUB_STATE not set}"
mkdir -p "$STATE"
printf '%s\n' "$*" >> "$STATE/calls.log"

cmd="${1:-}"
sub="${2:-}"
key="$cmd $sub"

if [ -n "${HERDR_STUB_FAIL:-}" ] && [ "$key" = "$HERDR_STUB_FAIL" ]; then
  printf '{"error":{"code":-32000,"message":"stub: forced failure on %s"}}\n' "$key" >&2
  exit 1
fi

# --- collect named flags -----------------------------------------------------
arg_cwd=""; arg_branch=""; arg_path=""; arg_label=""; arg_workspace=""
prev=""
for a in "$@"; do
  case "$prev" in
    --cwd) arg_cwd="$a" ;;
    --branch) arg_branch="$a" ;;
    --path) arg_path="$a" ;;
    --label) arg_label="$a" ;;
    --workspace) arg_workspace="$a" ;;
  esac
  prev="$a"
done

case "$key" in
  "worktree create")
    git -C "$arg_cwd" worktree add "$arg_path" -b "$arg_branch" >/dev/null 2>&1 \
      || { printf '{"error":{"code":-32001,"message":"stub: git worktree add failed"}}\n' >&2; exit 1; }
    printf '%s\n' "$arg_path"  > "$STATE/worktree_path"
    printf '%s\n' "$arg_cwd"   > "$STATE/repo_root"
    printf '%s\n' "$arg_label" > "$STATE/workspace_label"
    if [ -n "${HERDR_STUB_TOPLEVEL_IDS:-}" ]; then
      printf '{"id":"cli:worktree.create","workspace_id":"w1","tab_id":"w1:t1","pane_id":"w1:p1"}\n'
    else
      printf '{"id":"cli:worktree.create","result":{"workspace":{"workspace_id":"w1"},"tab":{"tab_id":"w1:t1"},"root_pane":{"pane_id":"w1:p1"}}}\n'
    fi
    ;;

  "worktree remove")
    if [ -n "${HERDR_STUB_REMOVE_REAL:-}" ] && [ -f "$STATE/worktree_path" ]; then
      wt="$(cat "$STATE/worktree_path")"
      root="$(cat "$STATE/repo_root")"
      git -C "$root" worktree remove --force "$wt" >/dev/null 2>&1 || true
    fi
    printf '{"id":"cli:worktree.remove","result":{}}\n'
    ;;

  "tab create")
    printf '{"id":"cli:tab.create","result":{"tab":{"tab_id":"w1:t2"},"root_pane":{"pane_id":"w1:p2"}}}\n'
    ;;

  "agent start")
    printf '{"id":"cli:agent.start","result":{"agent":{"pane_id":"w1:p3"}}}\n'
    ;;

  "pane get")
    if [ -n "${HERDR_STUB_DEAD_PANE:-}" ] && [ "${3:-}" = "w1:p3" ]; then
      printf '{"error":{"code":-32004,"message":"stub: no such pane"}}\n' >&2
      exit 1
    fi
    printf '{"id":"cli:pane.get","result":{"pane":{"pane_id":"%s"}}}\n' "${3:-}"
    ;;

  *)
    printf '{"id":"cli:%s.%s","result":{}}\n' "$cmd" "$sub"
    ;;
esac

exit 0

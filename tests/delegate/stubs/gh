#!/usr/bin/env bash
#
# Stub `gh` for herdr-delegate.sh tests.
#
#   GH_STUB_TITLE="..."  → `gh issue view N --json title -q .title` prints it
#   GH_STUB_FAIL=1       → the lookup fails (offline / not a GitHub repo),
#                          exercising the generic-label fallback

set -u
printf '%s\n' "$*" >> "${GH_STUB_LOG:-/dev/null}"

if [ -n "${GH_STUB_FAIL:-}" ]; then
  printf 'stub gh: could not resolve issue\n' >&2
  exit 1
fi

printf '%s\n' "${GH_STUB_TITLE:-}"
